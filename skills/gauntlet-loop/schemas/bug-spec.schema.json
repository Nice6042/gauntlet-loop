{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nice6042/gauntlet-loop/schemas/bug-spec.schema.json",
  "title": "Gauntlet Loop Bug Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "campaignId",
    "taskId",
    "bugId",
    "repository",
    "baseCommit",
    "artifactId",
    "areaId",
    "causalFingerprint",
    "title",
    "severity",
    "specStatus",
    "specReviewCount",
    "expectedBehavior",
    "expectedBehaviorAuthority",
    "actualBehavior",
    "impact",
    "reproduction",
    "rootCause",
    "proposedFix",
    "verification"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "campaignId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "bugId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+$"},
    "repository": {"type": "string", "minLength": 1},
    "baseCommit": {"type": "string", "minLength": 7},
    "artifactId": {"type": "string", "minLength": 1},
    "areaId": {"type": "string", "minLength": 1},
    "causalFingerprint": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "severity": {"enum": ["critical", "high", "medium", "low"]},
    "priority": {"type": "integer", "minimum": 0},
    "specStatus": {
      "enum": [
        "CANDIDATE",
        "SPEC_REVISION_REQUIRED",
        "SPEC_APPROVED",
        "FALSE_POSITIVE",
        "DUPLICATE",
        "EXPECTED_BEHAVIOR",
        "BLOCKED_BY_MISSING_EVIDENCE",
        "INCONCLUSIVE",
        "OUT_OF_SCOPE",
        "SPEC_REVIEW_LIMIT_REACHED"
      ]
    },
    "specReviewCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "expectedBehavior": {"type": "string", "minLength": 1},
    "expectedBehaviorAuthority": {"type": "string", "minLength": 1},
    "actualBehavior": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "affectedEnvironments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scopeExclusions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prerequisites", "steps", "observed", "evidence", "evidenceStrength"],
      "properties": {
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "observed": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidenceStrength": {"enum": ["direct", "boundary_observation", "static_causal_trace", "correlational", "testimonial", "absence"]}
      }
    },
    "rootCause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism", "underlyingCause", "causalChain", "evidence", "affectedSurfaces"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "underlyingCause": {"type": "string", "minLength": 1},
        "causalChain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim", "falsifier"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "falsifier": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "affectedSurfaces": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "proposedFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rootCauseResolution", "tradeoffs", "risks"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "rootCauseResolution": {"type": "string", "minLength": 1},
        "tradeoffs": {"type": "array", "items": {"type": "string"}},
        "risks": {"type": "array", "items": {"type": "string"}},
        "rollback": {"type": "string"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preFixFailure", "postFixExpected", "regressionChecks"],
      "properties": {
        "preFixFailure": {"type": "string", "minLength": 1},
        "postFixExpected": {"type": "string", "minLength": 1},
        "regressionChecks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "integrationChecks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "duplicateOf": {"type": "string"},
    "reviewDecisions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reviewer", "model", "effort", "evidence"],
        "properties": {
          "decision": {"type": "string"},
          "reviewer": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "effort": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
